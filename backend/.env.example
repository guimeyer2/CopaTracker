# Postgres (Railway em produção, local pra dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copatracker?schema=public

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Sessão (express-session)
SESSION_SECRET=troque-isto-por-um-segredo-aleatorio

# API-Football (api-sports.io) — header x-apisports-key
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE=1
API_FOOTBALL_SEASON=2026

# Frontend
FRONTEND_URL=http://localhost:5173

# Servidor
PORT=3001
