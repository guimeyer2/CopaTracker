# Postgres (Railway em produção, local pra dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copatracker?schema=public

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Sessão (express-session)
SESSION_SECRET=troque-isto-por-um-segredo-aleatorio

# TheSportsDB — fonte gratuita do calendário da Copa 2026
# Chave "3" é a pública de teste; league 4429 = FIFA World Cup
THESPORTSDB_KEY=3
THESPORTSDB_LEAGUE=4429
THESPORTSDB_SEASON=2026

# API-Football (api-sports.io) — caminho pago/legado, opcional
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE=1
API_FOOTBALL_SEASON=2022

# Frontend
FRONTEND_URL=http://localhost:5173

# Servidor
PORT=3001
